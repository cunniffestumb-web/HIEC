<svg width="200" height="60" viewBox="0 0 200 60" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#00ffff;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#0080ff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#8000ff;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect x="0" y="0" width="200" height="60" rx="8" fill="url(#logoGradient)" opacity="0.1"/>
  <text x="20" y="25" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="url(#logoGradient)">
    全息智能教育云
  </text>
  <text x="20" y="42" font-family="Arial, sans-serif" font-size="8" fill="#00ffff" opacity="0.8">
    HOLOGRAPHIC INTELLIGENT EDUCATION CLOUD
  </text>
</svg>